{
  "name": "@openbot/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-builder --config electron-builder.yml",
    "dist": "pnpm build && pnpm package",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@openbot/daemon": "workspace:*",
    "@openbot/protocol": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "electron": "36.5.0",
    "electron-builder": "26.15.7",
    "electron-vite": "5.0.0",
    "typescript": "^5.8.0",
    "vitest": "3.2.4",
    "@types/ws": "8.18.1"
  }
}
